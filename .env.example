# ---- SEATWISEE / DO! u want — environment configuration (copy to .env or set in Render / Streamlit secrets)
# Admin bootstrap (used only when the admin_users table is empty, i.e. first run)
SEATWISEE_ADMIN_PASSWORD=change-me
SEATWISEE_ADMIN_EMAIL=admissions@example.edu

# Storage (defaults: ./seatwisee.db and ./uploads)
# SEATWISEE_DB=/var/data/seatwisee.db
# SEATWISEE_UPLOADS=/var/data/uploads

# ---- Email (SMTP). Gmail: host smtp.gmail.com, port 587, starttls, an App Password (not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=DO! u want Admissions <you@gmail.com>
SMTP_TLS=starttls

# ---- WhatsApp Business Cloud API (Meta). Create an app at developers.facebook.com → WhatsApp → API setup
WHATSAPP_TOKEN=EAAG...your-permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Optional: an approved template with one {{1}} body parameter; without it free-form text is sent
# (free-form text is only delivered inside a 24-hour customer-service window)
# WHATSAPP_TEMPLATE=seatwisee_update
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v20.0
